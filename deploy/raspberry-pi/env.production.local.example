# Copy to .env.production.local on the Raspberry Pi.
# Keep this file mock-safe for public demos.
NODE_ENV=production
PORT=8899
STATIC_DIR=dist
ZHIHU_PROVIDER=mock
VITE_DEMO_MODEL_MODE=mock
VITE_DEMO_DEFAULT_PROVIDER=mock
VITE_DEMO_FALLBACK_TO_MOCK=true

# Optional: set this after the public domain is ready.
# PUBLIC_APP_URL=https://zhihu-roundtable.example.com
