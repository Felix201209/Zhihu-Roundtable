# Demo defaults
# Leave API keys empty for mock-safe local judging. With keys present, the app
# prefers real DeepSeek model calls and falls back to mock only when configured.
ZHIHU_PROVIDER=mock
VITE_DEMO_MODEL_MODE=auto
VITE_DEMO_DEFAULT_PROVIDER=deepseek-v4-pro
VITE_DEMO_FALLBACK_TO_MOCK=true

# Final submission verification helpers
# PUBLIC_DEMO_URL=https://your-demo-domain.com
# Set to 1 only after reviewers/organizers can access the private repository.
# REVIEWER_REPO_ACCESS_CONFIRMED=

# Kimi / Moonshot live model provider
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2.6
# VITE_DEMO_MODEL_MODE=auto
# VITE_DEMO_DEFAULT_PROVIDER=kimi
# VITE_DEMO_KIMI_MODEL=kimi-k2.6

# DeepSeek live model provider
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=1
# VITE_DEMO_DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# VITE_DEMO_DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# LLM_CACHE_ENABLED=true
# LLM_CACHE_FILE=.cache/llm-json-cache.json
# LLM_CACHE_TTL_MS=86400000
# LLM_CACHE_ERROR_TTL_MS=300000

# Zhihu live provider
# ZHIHU_PROVIDER=live
# Real fetch only accepts Zhihu HTTPS domains to avoid leaking official HMAC headers.
# ZHIHU_API_BASE_URL=https://openapi.zhihu.com
# Official Hackathon OpenAPI credentials. Keep private.
# ZHIHU_APP_KEY=your_zhihu_user_token
# ZHIHU_APP_SECRET=your_official_app_secret
# Legacy alias for app_key/user token:
# ZHIHU_ACCESS_TOKEN=
# Optional default ring and hot-list window.
# Default: 2029619126742656657 (黑客松脑洞补给站)
# ZHIHU_RING_ID=2029619126742656657
# ZHIHU_HOT_LIST_HOURS=24
# ZHIHU_REQUIRE_CONFIRMATION=true
# ZHIHU_CACHE_ENABLED=true
# ZHIHU_CACHE_FILE=.cache/zhihu-openapi-cache.json
# ZHIHU_CACHE_HOT_TTL_MS=1800000
# ZHIHU_CACHE_SEARCH_TTL_MS=43200000
# ZHIHU_CACHE_RING_TTL_MS=86400000
# ZHIHU_CACHE_COMMENT_TTL_MS=60000
# ZHIHU_CACHE_ERROR_TTL_MS=900000
# Override only if Zhihu publishes a different path for your app.
# ZHIHU_ENDPOINT_HOT_LIST=/api/v1/content/hot_list
# ZHIHU_ENDPOINT_ZHIHU_SEARCH=/api/v1/content/zhihu_search
# ZHIHU_ENDPOINT_GLOBAL_SEARCH=/api/v1/content/global_search
# ZHIHU_ENDPOINT_RING_DETAIL=/openapi/ring/detail

# Zhihu OAuth login callback for the Hackathon Square project form.
# Use https://your-demo-domain.com/api/oauth/callback as callback URL.
# PUBLIC_APP_URL=
# ZHIHU_OAUTH_REDIRECT_URI=
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# ZHIHU_OAUTH_CLIENT_ID=
# ZHIHU_OAUTH_AUTHORIZE_URL=https://openapi.zhihu.com/authorize
# ZHIHU_OAUTH_TOKEN_URL=https://openapi.zhihu.com/access_token
# ZHIHU_OAUTH_TOKEN_BODY_MODE=form
# ZHIHU_OAUTH_USER_INFO_URL=https://openapi.zhihu.com/oauth/user_info
# ZHIHU_OAUTH_USER_FOLLOWERS_URL=https://openapi.zhihu.com/oauth/user_followers
# ZHIHU_OAUTH_SESSION_FILE=.cache/oauth-sessions.json
# ZHIHU_OAUTH_SCOPE=
# ZHIHU_OAUTH_CLIENT_SECRET=

# AI cost guard. Use ip immediately for public demos; switch to oauth after
# official Zhihu authorize/token URLs are configured.
# AI_USAGE_GUARD_MODE=off
# AI_USAGE_DAILY_CREDITS=30
# AI_USAGE_ANON_DAILY_CREDITS=12
# AI_USAGE_AUTH_DAILY_CREDITS=30
# AI_USAGE_PROJECT_SHARE_REWARD_CREDITS=20

# Zhihu Direct Answer Agent (OpenAI-compatible /v1/chat/completions)
# Use as VITE_DEMO_DEFAULT_PROVIDER=custom or roleMap custom in backend requests.
# ZHIHU_DIRECT_AGENT_API_KEY=
# ZHIHU_DIRECT_AGENT_BASE_URL=https://api.zhihu.com/v1
# ZHIHU_DIRECT_AGENT_MODEL=zhihu-direct-agent
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://api.zhihu.com/v1
# CUSTOM_LLM_MODEL=zhihu-direct-agent
